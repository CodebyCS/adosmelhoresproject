@page "/financas"

<div class="container-fluid py-4">
    <div class="row g-4">
        @* COLUNA ESQUERDA: TRANSAÇÕES E GRÁFICO *@
        <div class="col-lg-8">
            <div class="custom-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Registro de Transações</h5>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Pesquisar..." style="width: 200px;" @bind="termoPesquisa" @bind:event="oninput">
                        <select class="form-select form-select-sm" style="width: 150px;" @bind="filtroTipo">
                            <option value="Todos">Todos os Tipos</option>
                            <option value="Receita">Receitas</option>
                            <option value="Despesa">Despesas</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>TIPO</th>
                                <th>REF/FUNCIONÁRIO</th>
                                <th>DATA</th>
                                <th>VALOR</th>
                                <th>ESTADO</th>
                                @* Coluna de Ações removida daqui *@
                            </tr>
                        </thead>
                        <tbody>
                            @if (ListaTransacoes == null || !ListaTransacoes.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Sem transações registadas.</td></tr>
                            }
                            else
                            {
                                @foreach (var t in ListaTransacoes)
                                {
                                    <tr>
                                        <td class="text-muted small">@t.Id</td>
                                        <td class="fw-bold">@t.Descricao</td>
                                        <td>@t.Referencia</td>
                                        <td class="small">@t.Data.ToShortDateString()</td>
                                        <td class="@(t.Valor < 0 ? "text-danger" : "text-success") fw-bold">
                                            @(t.Valor < 0 ? "-" : "+")€@Math.Abs(t.Valor).ToString("N2")
                                        </td>
                                        <td>
                                            <span class="status-badge @(t.Estado == "Pago" || t.Estado == "Recebido" ? "bg-success-subtle text-success" : "bg-info-subtle text-info")">
                                                @t.Estado
                                            </span>
                                        </td>
                                        @* Célula do botão Alterar removida daqui *@
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* GRÁFICO DE FLUXO DE CAIXA *@
            <div class="custom-card p-4 mt-4 shadow-sm">
                <h6 class="fw-bold mb-4 small text-uppercase text-muted">Fluxo de Caixa (Receitas vs Despesas)</h6>
                <div class="d-flex align-items-end justify-content-between px-2" style="height: 200px; border-bottom: 2px solid #e2e8f0;">
                    @for (int i = 0; i < FluxoMensal.Count; i++)
                    {
                        var mes = FluxoMensal[i];
                        <div class="d-flex gap-1 align-items-end h-100" style="width: 12%;">
                            <div class="bg-primary @(i == FluxoMensal.Count - 1 ? "shadow" : "opacity-75")"
                                 style="height: @(mes.ReceitaPerc)%; width: 10px; border-radius: 3px 3px 0 0;"
                                 title="Receita: €@mes.Receita"></div>
                            <div class="bg-secondary opacity-50"
                                 style="height: @(mes.DespesaPerc)%; width: 10px; border-radius: 3px 3px 0 0;"
                                 title="Despesa: €@mes.Despesa"></div>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between mt-2 px-2 text-muted small fw-bold">
                    @foreach (var mes in FluxoMensal)
                    {
                        <span style="width: 12%; text-align: center;">@mes.Nome</span>
                    }
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: VISÃO GERAL E EXPORTAÇÃO *@
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-sm">
                <h5 class="fw-bold mb-4">Visão Geral Financeira</h5>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Saldo Atual</span>
                    <h3 class="fw-bold text-dark mb-0">€@SaldoAtual.ToString("N2")</h3>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Receitas Este Mês</span>
                    <h4 class="fw-bold text-success mb-0">€@ReceitasMes.ToString("N2")</h4>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Despesas Este Mês</span>
                    <h4 class="fw-bold text-danger mb-0">€@DespesasMes.ToString("N2")</h4>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Rentabilidade</span>
                    <h4 class="fw-bold text-primary mb-0">@Rentabilidade.ToString("F1")%</h4>
                </div>
            </div>

            <div class="custom-card p-4 mt-4 shadow-sm">
                <h6 class="fw-bold mb-3 small text-uppercase text-muted">Ferramentas e Alertas</h6>
                <button @onclick="ExportarPDF" class="btn btn-outline-primary w-100 py-2 mb-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-file-earmark-pdf me-2 fs-5"></i> Exportar Auditoria (PDF)
                </button>
                <button @onclick="ExportarExcel" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-file-earmark-excel me-2 fs-5"></i> Exportar Contabilidade (Excel)
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string termoPesquisa = "";
    private string filtroTipo = "Todos";

    [Parameter] public double SaldoAtual { get; set; } = 24750.50;
    [Parameter] public double ReceitasMes { get; set; } = 8200.00;
    [Parameter] public double DespesasMes { get; set; } = 5950.00;
    public double Rentabilidade => ReceitasMes > 0 ? ((ReceitasMes - DespesasMes) / ReceitasMes) * 100 : 0;

    [Parameter]
    public List<TransacaoDTO> ListaTransacoes { get; set; } = new() {
        new TransacaoDTO { Id="F001", Descricao="Salários", Referencia="John Doe", Data=DateTime.Now, Valor=-1850, Estado="Agendado" },
        new TransacaoDTO { Id="F003", Descricao="Inscrição", Referencia="Cliente XPTO", Data=DateTime.Now, Valor=500, Estado="Recebido" }
    };

    [Parameter]
    public List<FluxoMesDTO> FluxoMensal { get; set; } = new() {
        new FluxoMesDTO { Nome="Jan", Receita=2100, Despesa=1400 },
        new FluxoMesDTO { Nome="Fev", Receita=3200, Despesa=2100 },
        new FluxoMesDTO { Nome="Mar", Receita=4500, Despesa=2300 },
        new FluxoMesDTO { Nome="Abr", Receita=3800, Despesa=1900 }
    };

    private void ExportarPDF() { }
    private void ExportarExcel() { }

    public class TransacaoDTO
    {
        public string Id { get; set; }
        public string Descricao { get; set; }
        public string Referencia { get; set; }
        public DateTime Data { get; set; }
        public double Valor { get; set; }
        public string Estado { get; set; }
    }

    public class FluxoMesDTO
    {
        public string Nome { get; set; }
        public double Receita { get; set; }
        public double Despesa { get; set; }
        public int ReceitaPerc => 70;
        public int DespesaPerc => 45;
    }
}