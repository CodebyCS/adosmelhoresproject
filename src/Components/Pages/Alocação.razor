@page "/alocacao"
@inject NavigationManager Navigation

<div class="container-fluid py-4">
    <div class="row g-4">
        @* COLUNA ESQUERDA: LISTA DE ALOCAÇÕES *@
        <div class="col-lg-8">
            <div class="custom-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Diretório de Alocações</h5>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm" placeholder="Pesquisar..." style="width: 200px;" @bind="termoPesquisa" @bind:event="oninput">
                        <select class="form-select form-select-sm" style="width: 150px;" @bind="filtroRecurso">
                            <option value="Todos">Todos os Recursos</option>
                            <option value="Sala">Salas</option>
                            <option value="Viatura">Viaturas</option>
                            <option value="Equipamento">Equipamentos</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>FUNCIONÁRIO</th>
                                <th>NOME DO CURSO</th>
                                <th>RECEITA</th>
                                <th>INÍCIO</th>
                                <th>FIM</th>
                                <th class="text-end">AÇÕES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ListaAlocacoes == null || !ListaAlocacoes.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">Nenhuma alocação registada.</td></tr>
                            }
                            else
                            {
                                @foreach (var a in ListaAlocacoes)
                                {
                                    <tr>
                                        <td class="text-muted small">@a.Id</td>
                                        <td class="fw-bold">@a.FuncionarioNome</td>
                                        <td>@a.RecursoNome</td>
                                        <td class="fw-bold text-success">@a.ValorReceita.ToString("N2")€</td>
                                        <td class="small">@a.DataInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small">@a.DataFim.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AbrirModalEditar(a.Id)">Alterar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* DASHBOARD INFERIOR *@
            <div class="row g-4 mt-1">
                <div class="col-md-6">
                    <div class="custom-card p-3 shadow-sm">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Utilização de Salas (Próx. 7 Dias)</h6>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(PercentagemLivre)%"></div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>Salas Livres: @(PercentagemLivre)%</span>
                            <span>Ocupadas: @(100 - PercentagemLivre)%</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="custom-card p-3 shadow-sm">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Atividades Recentes</h6>
                        <div class="small" style="max-height: 80px; overflow-y: auto;">
                            @foreach (var log in LogsAtividade)
                            {
                                <div class="d-flex align-items-center mb-2 border-bottom pb-1">
                                    <i class="bi bi-clock-history me-2 text-primary"></i>
                                    <span>@log</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: FORMULÁRIO DE CRIAÇÃO *@
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-sm">
                <h5 class="fw-bold mb-4 text-primary">Nova Alocação</h5>
                <form>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Funcionário</label>
                        <select class="form-select" @bind="alocacaoFuncionarioId">
                            <option value="">Selecionar funcionário...</option>
                            @foreach (var f in ListaFuncionariosDisponiveis)
                            {
                                <option value="@f.Id">@f.Nome (@f.Tipo)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Nome do Curso</label>
                        <input type="text" class="form-control" placeholder="Ex: C# Avançado" @bind="tipoRecursoSelecionado" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Valor da Receita</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">€</span>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" @bind="recursoSelecionadoId" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Início</label>
                            <input type="datetime-local" class="form-control" @bind="dataInicio">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Fim</label>
                            <input type="datetime-local" class="form-control" @bind="dataFim">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Notas de Reserva</label>
                        <textarea class="form-control" rows="3" @bind="notasAlocacao" placeholder="Informação adicional..."></textarea>
                    </div>

                    <button type="button" @onclick="CriarAlocacao" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        Confirmar Alocação
                    </button>
                    <button type="button" @onclick="LimparFormulario" class="btn btn-link w-100 text-secondary mt-2 small text-decoration-none">
                        Limpar Campos
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@* --- JANELA FLUTUANTE (MODAL) --- *@
@if (exibirModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Editar Registo @alocacaoParaEditar.Id</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Funcionário</label>
                        <select class="form-select" @bind="alocacaoParaEditar.FuncionarioNome">
                            @foreach (var f in ListaFuncionariosDisponiveis)
                            {
                                <option value="@f.Nome">@f.Nome (@f.Tipo)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Nome do Curso</label>
                        <input type="text" class="form-control" @bind="alocacaoParaEditar.RecursoNome" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Valor da Receita (€)</label>
                        <input type="number" step="0.01" class="form-control" @bind="alocacaoParaEditar.ValorReceita" />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Início</label>
                            <input type="datetime-local" class="form-control" @bind="alocacaoParaEditar.DataInicio" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-muted">Fim</label>
                            <input type="datetime-local" class="form-control" @bind="alocacaoParaEditar.DataFim" />
                        </div>
                    </div>
                    @* FIX: Substituído Estado por Notas com Textarea *@
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Notas de Reserva</label>
                        <textarea class="form-control" rows="3" @bind="alocacaoParaEditar.Notas"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModal">Cancelar</button>
                    <button type="button" class="btn btn-primary px-4" @onclick="SalvarEdicao">Guardar Alterações</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool exibirModal = false;
    private AlocacaoDTO alocacaoParaEditar = new();
    private string termoPesquisa = "";
    private string filtroRecurso = "Todos";

    // Variáveis do Form de Criação
    private string alocacaoFuncionarioId = "";
    private string tipoRecursoSelecionado = "";
    private string recursoSelecionadoId = "";
    private DateTime dataInicio = DateTime.Now;
    private DateTime dataFim = DateTime.Now.AddHours(4);
    private string notasAlocacao = "";

    [Parameter] public int PercentagemLivre { get; set; } = 85;

    [Parameter]
    public List<string> LogsAtividade { get; set; } = new()
    {
        "Novo curso 'C# Avançado' registado hoje às 09:00",
        "Pagamento de receita A001 confirmado",
        "Base de dados de funcionários atualizada"
    };

    [Parameter]
    public List<AlocacaoDTO> ListaAlocacoes { get; set; } = new()
    {
        new AlocacaoDTO { Id = "A001", FuncionarioNome = "John Doe", RecursoNome = "C# Básico", ValorReceita = 150.00m, DataInicio = DateTime.Now, DataFim = DateTime.Now.AddHours(2), Notas = "Sala 1 reservada" },
        new AlocacaoDTO { Id = "A002", FuncionarioNome = "Ana Silva", RecursoNome = "Excel Expert", ValorReceita = 250.00m, DataInicio = DateTime.Now.AddDays(1), DataFim = DateTime.Now.AddDays(1).AddHours(3), Notas = "Requer projetor" }
    };

    [Parameter]
    public List<FuncionarioSimples> ListaFuncionariosDisponiveis { get; set; } = new()
    {
        new FuncionarioSimples { Id = "1", Nome = "John Doe", Tipo = "Diretor" },
        new FuncionarioSimples { Id = "2", Nome = "Ana Silva", Tipo = "Coordenadora" }
    };

    private void AbrirModalEditar(string id)
    {
        var original = ListaAlocacoes.FirstOrDefault(a => a.Id == id);
        if (original != null)
        {
            // Criar cópia para edição
            alocacaoParaEditar = new AlocacaoDTO
            {
                Id = original.Id,
                FuncionarioNome = original.FuncionarioNome,
                RecursoNome = original.RecursoNome,
                ValorReceita = original.ValorReceita,
                DataInicio = original.DataInicio,
                DataFim = original.DataFim,
                Notas = original.Notas
            };
            exibirModal = true;
        }
    }

    private void FecharModal() => exibirModal = false;

    private void SalvarEdicao()
    {
        var index = ListaAlocacoes.FindIndex(a => a.Id == alocacaoParaEditar.Id);
        if (index != -1)
        {
            ListaAlocacoes[index] = alocacaoParaEditar;
            LogsAtividade.Insert(0, $"O curso '{alocacaoParaEditar.RecursoNome}' foi editado às {DateTime.Now:HH:mm}");
        }
        exibirModal = false;
    }

    private void CriarAlocacao() { /* Lógica de criação */ }

    private void LimparFormulario()
    {
        tipoRecursoSelecionado = "";
        recursoSelecionadoId = "";
        alocacaoFuncionarioId = "";
        notasAlocacao = "";
    }

    public class AlocacaoDTO
    {
        public string Id { get; set; }
        public string FuncionarioNome { get; set; }
        public string RecursoNome { get; set; }
        public decimal ValorReceita { get; set; }
        public DateTime DataInicio { get; set; }
        public DateTime DataFim { get; set; }
        public string Notas { get; set; }
    }

    public class FuncionarioSimples
    {
        public string Id { get; set; }
        public string Nome { get; set; }
        public string Tipo { get; set; }
    }
}