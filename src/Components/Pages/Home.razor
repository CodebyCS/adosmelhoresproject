@page "/"
@inject NavigationManager Navigation

<div class="container-fluid py-4">
    <div class="row g-4 mb-4">
        @* BOAS-VINDAS *@
        <div class="col-lg-7">
            <div class="custom-card p-4 h-100">
                <h2 class="fw-bold text-dark">Bem-vindo, @NomeUtilizador!</h2>
                <p class="text-secondary mb-0">Hoje é dia <strong>@DataSistema.ToLongDateString()</strong></p>
            </div>
        </div>

        @* GRÁFICO DINÂMICO *@
        <div class="col-lg-5">
            <div class="custom-card p-4">
                <h6 class="fw-bold mb-4">Inscrições Semanais</h6>
                <div class="chart-container">
                    <div class="chart-y-axis">
                        <span>0</span><span>4</span><span>8</span><span>12</span>
                    </div>
                    @* As barras agora são geradas com base numa lista de valores *@
                    @for (int i = 0; i < InscritosPorSemana.Length; i++)
                    {
                        var altura = (InscritosPorSemana[i] * 100 / 12); // Cálculo de % baseado no máximo (12)
                        <div class="bar @(i == 2 ? "bar-primary shadow-sm" : "bar-light")"
                             style="height: @(altura)%; width: 18%;"
                             title="Inscrições: @InscritosPorSemana[i]">
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between mt-2 ps-5 pe-2 text-muted fw-bold small">
                    <span>Sem 1</span><span>Sem 2</span><span>Sem 3</span><span>Sem 4</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* ALERTAS DINÂMICOS *@
        <div class="col-lg-4">
            <div class="custom-card p-4 h-100">
                <h6 class="fw-bold mb-3">Alertas e Notificações</h6>
                
                @if (ContratosExpirar > 0)
                {
                    <div class="alert alert-danger d-flex align-items-center py-2 border-0 shadow-sm mb-2" style="font-size: 0.85rem; background-color: #fee2e2; color: #991b1b;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ContratosExpirar Contratos a expirar
                    </div>
                }

                @if (InscricoesPendentes > 0)
                {
                    <div class="alert alert-warning d-flex align-items-center py-2 border-0 shadow-sm" style="font-size: 0.85rem; background-color: #fef3c7; color: #92400e;">
                        <i class="bi bi-info-circle-fill me-2"></i> @InscricoesPendentes Inscrições pendentes
                    </div>
                }
                
                @if (ContratosExpirar == 0 && InscricoesPendentes == 0)
                {
                    <p class="small text-muted">Não há alertas para hoje.</p>
                }
            </div>
        </div>

        @* AÇÕES RÁPIDAS (Navegação) *@
        <div class="col-lg-4">
            <div class="custom-card p-4 h-100">
                <h6 class="fw-bold mb-3">Ações Rápidas</h6>
                <div class="d-flex gap-2">
                    <button @onclick='() => Navigation.NavigateTo("funcionarios")' class="btn btn-primary flex-fill py-3 d-flex flex-column align-items-center border-0 shadow-sm">
                        <i class="bi bi-person-plus fs-2 mb-1 text-white"></i>
                        <span class="small fw-bold">Add Funcionário</span>
                    </button>
                    <button @onclick='() => Navigation.NavigateTo("alocacao")' class="btn btn-outline-primary flex-fill py-3 d-flex flex-column align-items-center shadow-sm">
                        <i class="bi bi-calendar-event fs-2 mb-1"></i>
                        <span class="small fw-bold">Agendar</span>
                    </button>
                </div>
            </div>
        </div>

        @* ATIVIDADES PRÓXIMAS *@
        <div class="col-lg-4">
            <div class="custom-card p-4 h-100">
                <h6 class="fw-bold mb-3">Próximas Atividades</h6>
                @foreach (var atividade in ListaAtividades)
                {
                    <div class="border-start border-4 @atividade.CorClasse ps-3 mb-3">
                        <div class="small fw-bold">@atividade.Titulo</div>
                        <p class="small text-muted mb-0">@atividade.Local | @atividade.Hora</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    // VARIÁVEIS PARA O BACK-END PREENCHER
    [Parameter] public string NomeUtilizador { get; set; } = "Administrador";
    [Parameter] public DateTime DataSistema { get; set; } = DateTime.Now;
    
    [Parameter] public int ContratosExpirar { get; set; } = 2;
    [Parameter] public int InscricoesPendentes { get; set; } = 4;

    // Dados do Gráfico (4 semanas)
    [Parameter] public int[] InscritosPorSemana { get; set; } = { 8, 5, 11, 4 };

    // Simulação de lista de atividades
    [Parameter]
    public List<AtividadeSimples> ListaAtividades { get; set; } = new()
    {
        new AtividadeSimples { Titulo = "Formação Azure", Local = "Conherto", Hora = "18:00h", CorClasse = "border-primary" },
        new AtividadeSimples { Titulo = "Manutenção de Sala 3", Local = "Hoje", Hora = "20:00h", CorClasse = "border-warning" }
    };

    // Classe auxiliar para as atividades
    public class AtividadeSimples
    {
        public string Titulo { get; set; } = "";
        public string Local { get; set; } = "";
        public string Hora { get; set; } = "";
        public string CorClasse { get; set; } = "border-primary";
    }
}
