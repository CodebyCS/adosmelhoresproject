@inherits LayoutComponentBase
@using adosmelhoresproject.src.Services
@inject DateService DateService
@implements IDisposable

<div class="d-flex" style="min-height: 100vh;">
    @* SIDEBAR *@
    <div class="sidebar-wrapper" style="width: 280px; background-color: #1a237e; min-height: 100vh;">
        <NavMenu />
    </div>

    @* ÁREA PRINCIPAL *@
    <main class="flex-grow-1" style="background-color: #f8f9fa;">
        @* TOP ROW *@
        <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm" style="height: 60px;">
            <div class="d-flex align-items-center">
                <i class="bi bi-calendar3 me-2 text-primary"></i>
                @* Substituímos o texto estático pela data do serviço *@
                <span class="fw-bold text-secondary small text-uppercase">
                    SYSTEM DATE: [@DateService.GetCurrentDate().ToString("yyyy-MM-dd")]
                </span>
            </div>
            <div>
                @* Adicionado o @onclick para chamar a função de avançar *@
                <button class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill" @onclick="HandleAdvanceDay">
                    <i class="bi bi-plus-circle me-1"></i> Advance 1 Day
                </button>
            </div>
        </div>

        @* O CONTEÚDO DAS PÁGINAS *@
        <article class="content px-4 py-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        // Subscreve ao evento. Quando a data mudar no serviço, este componente corre o "Refresh"
        DateService.OnDateChanged += RefreshUI;
    }

    private void HandleAdvanceDay()
    {
        // Chama o método do teu DateService
        DateService.AvancarDia();
    }

    private void RefreshUI()
    {
        // Força o Blazor a redesenhar o ecrã para mostrar a nova data
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Importante: remove a subscrição quando saíres da página para evitar gasto de memória
        DateService.OnDateChanged -= RefreshUI;
    }
}