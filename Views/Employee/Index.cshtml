@model IEnumerable<adosmelhoresproject.src.Models.Employee>
@using adosmelhoresproject.src.Models
@{
    ViewData["Title"] = "Gestão de Funcionários";
    
    // Listas auxiliares filtradas para alimentar os selects dinâmicos
    var listaFormadores = Model.OfType<Trainer>().ToList();
    var listaDiretores = Model.OfType<Director>().ToList();
}

<div class="container-fluid py-4">
    <div class="row g-4">

        @* COLUNA ESQUERDA: LISTA *@
        <div class="col-lg-8">
            <div class="custom-card mb-4 p-4 bg-white shadow-sm rounded border">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold m-0 text-dark">Diretório de Funcionários</h5>
                    <div class="d-flex gap-2">
                        @* BOTÕES DE FILTRO REQUISITOS 2.c e 2.d *@
                        <a asp-controller="Employee" asp-action="Index"
                               class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.FiltroAtual) ? "btn-primary shadow-sm" : "btn-outline-primary")">
                            Todos
                        </a>
                        <a asp-controller="Employee" asp-action="Index" asp-route-filtro="contratos_validos"
                               class="btn btn-sm @(ViewBag.FiltroAtual == "contratos_validos" ? "btn-primary shadow-sm" : "btn-outline-primary")">
                            Contratos Válidos
                        </a>
                        <a asp-controller="Employee" asp-action="Index" asp-route-filtro="registos_expirados"
                               class="btn btn-sm @(ViewBag.FiltroAtual == "registos_expirados" ? "btn-primary shadow-sm" : "btn-outline-primary")">
                            RC Expirados
                        </a>

                        <input type="text" id="pesquisaNome" class="form-control form-control-sm ms-2" placeholder="Pesquisar..." style="width: 200px;">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>ID</th>
                                <th>NOME</th>
                                <th>FUNÇÃO</th>
                                <th>ESTADO RC</th>
                                <th>ESTADO CONTRATO</th>
                                <th class="text-end">AÇÕES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model)
                            {
                                <tr>
                                    <td class="text-muted small">#@f.Id</td>
                                    <td class="fw-bold">@f.Name</td>
                                    <td><span class="badge bg-light text-dark border">@f.GetType().Name</span></td>
                                    
                                    @* BADGE: REGISTO CRIMINAL *@
                                    <td>
                                        @if (f.CriminalRecordDate.Date >= ((DateTime)ViewBag.CurrentDate).Date)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Válido</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Expirado</span>
                                        }
                                    </td>

                                    @* BADGE: ESTADO DO CONTRATO *@
                                    <td>
                                        @if (f.ContractEndDate.Date >= ((DateTime)ViewBag.CurrentDate).Date)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Ativo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Expirado</span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="btn-group shadow-sm">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Editar Detalhes"
                                                    data-id="@f.Id"
                                                    data-nome="@f.Name"
                                                    data-contrato="@f.ContractEndDate.ToString("yyyy-MM-dd")"
                                                    data-tipo="@f.GetType().Name"
                                                    data-hours="@(f is Director ? ((Director)f).HoursExemption.ToString().ToLower() : "")"
                                                    data-bonus="@(f is Director ? ((Director)f).MonthlyBonus : 0)"
                                                    data-rate="@(f is Trainer ? ((Trainer)f).HourlyRate : 0)"
                                                    data-teaching="@(f is Trainer ? ((Trainer)f).TeachingArea : "")"
                                                    data-area="@(f is Secretary ? ((Secretary)f).Area : "")"
                                                    data-director="@(f is Secretary ? ((Secretary)f).DirectorName : "")"
                                                    onclick="abrirModalEdicao(this)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            @if (f is Trainer t)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary" title="Calcular Pagamento"
                                                        onclick="abrirModalPagamento('@f.Id', '@f.Name', '@t.HourlyRate')">
                                                    <i class="bi bi-calculator"></i>
                                                </button>
                                            }

                                            <button type="button" class="btn btn-sm btn-light border" onclick="abrirModalRC('@f.Id', '@f.Name')" title="Atualizar Registo Criminal">
                                                <i class="bi bi-shield-check"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* CARDS DE RESUMO *@
            <div class="row">
                <div class="col-md-6">
                    <div class="p-3 bg-white shadow-sm rounded border-start border-4 border-warning h-100">
                        <h6 class="fw-bold mb-3 text-primary small">ALERTAS</h6>
                        <p class="mb-1 small">Contratos Expirados: <span class="badge bg-danger">@ViewBag.ExpiredContracts</span></p>
                        <p class="mb-0 small">Registo Criminal Expirado: <span class="badge bg-warning text-dark">@ViewBag.ExpiredCriminalRecords</span></p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-white shadow-sm rounded border-start border-4 border-success d-flex flex-column justify-content-between h-100">
                        <div>
                            <h6 class="fw-bold mb-2 small text-muted">FOLHA SALARIAL MENSAL</h6>
                            <h3 class="text-success fw-bold mb-3">€ @ViewBag.TotalMonthlyExpense.ToString("N2")</h3>
                        </div>
                        <div>
                            <a asp-controller="Employee" asp-action="ExportarCSV" class="btn btn-sm btn-outline-success w-100 fw-bold">
                                <i class="bi bi-download me-1"></i> Exportar Dados para CSV
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: FORMULÁRIO DE CRIAÇÃO *@
        <div class="col-lg-4">
            <div class="p-4 bg-white shadow-sm rounded border-top border-primary border-4">
                <h5 class="fw-bold mb-4">Novo Funcionário</h5>
                <form asp-controller="Employee" asp-action="Criar" method="post">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Nome Completo</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Função</label>
                        <select id="tipoSelect" name="type" class="form-select" onchange="atualizarCamposDinamicos()">
                            <option value="Secretaria">Secretaria</option>
                            <option value="Director">Diretor</option>
                            <option value="Trainer">Formador</option>
                            <option value="Coordinator">Coordenador</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Salário Base (€)</label>
                        <input type="number" name="salary" class="form-control" value="1000" step="0.01">
                    </div>

                    @* NOVO CAMPO: FIM DE CONTRATO *@
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Fim de Contrato</label>
                        <input type="date" name="ContractEndDate" class="form-control" required value="@(((DateTime)ViewBag.CurrentDate).AddYears(1).ToString("yyyy-MM-dd"))">
                    </div>

                    <div id="camposEspecificos" class="p-3 mb-4 rounded bg-light border border-dashed">
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold shadow">
                        <i class="bi bi-save me-2"></i>Guardar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@* --- TEMPLATES ESCONDIDOS EM HTML (PREVENÇÃO DE ERROS JS) --- *@
<div id="templateSecretaria" style="display:none;">
    <div class="mb-2">
        <label class="small text-muted fw-bold">Setor / Área</label>
        <input type="text" name="Area" class="form-control form-control-sm" placeholder="Ex: Financeiro">
    </div>
    <div class="mb-2">
        <label class="small text-muted fw-bold">Diretor Associado</label>
        <select name="DirectorName" class="form-select form-select-sm">
            <option value="">-- Sem Diretor --</option>
            @foreach (var d in listaDiretores)
            {
                <option value="@d.Name">@d.Name</option>
            }
        </select>
    </div>
</div>

<div id="templateCoordenador" style="display:none;">
    <div class="mb-2">
        <label class="small text-muted fw-bold">Associar Formadores</label>
        <div class="p-2 bg-white border rounded shadow-sm" style="max-height: 150px; overflow-y: auto;">
            @if (listaFormadores.Any())
            {
                foreach (var f in listaFormadores)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="SelectedTrainerIds" value="@f.Id" id="f_@f.Id">
                        <label class="form-check-label small" for="f_@f.Id">@f.Name</label>
                    </div>
                }
            }
            else
            {
                <p class="text-muted small m-0">Nenhum formador disponível.</p>
            }
        </div>
    </div>
</div>

@* Templates auxiliares para injeção no Modal de Edição via JS *@
<div id="templateSecretariaEdicao" style="display:none;">
    <select id="editSelectDirectorHelper" class="form-select">
        <option value="">-- Sem Diretor --</option>
        @foreach (var d in listaDiretores)
        {
            <option value="@d.Name">@d.Name</option>
        }
    </select>
</div>

<div id="templateCoordenadorEdicao" style="display:none;">
    <div class="mb-2">
        <label class="small text-muted fw-bold">Formadores Associados</label>
        <div class="p-2 bg-white border rounded shadow-sm" style="max-height: 150px; overflow-y: auto;">
            @foreach (var f in listaFormadores)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SelectedTrainerIds" value="@f.Id" id="edit_f_@f.Id">
                    <label class="form-check-label small" for="edit_f_@f.Id">@f.Name</label>
                </div>
            }
        </div>
    </div>