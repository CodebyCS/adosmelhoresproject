@model IEnumerable<adosmelhoresproject.src.Models.Employee>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill"></i> Gestão de Funcionários</h2>
        <div>
            <a asp-action="ExportarCSV" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-spreadsheet"></i> Exportar CSV</a>
            <a asp-action="Criar" class="btn btn-primary"><i class="bi bi-person-plus-fill"></i> Novo Funcionário</a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col">
            <a asp-action="ContratosValidos" class="btn btn-sm btn-outline-info">Contratos Válidos</a>
            <a asp-action="RegistoCriminalExpirado" class="btn btn-sm btn-outline-danger">Registos Expirados</a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Tipo</th>
                    <th>Fim Contrato</th>
                    <th>Reg. Criminal</th>
                    <th>Salário</th>
                    <th>Status</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Active ? "" : "table-light text-muted")">
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td><span class="badge bg-secondary">@item.GetType().Name</span></td>
                        <td>@item.ContractEndDate.ToShortDateString()</td>
                        <td>@item.CriminalRecordDate.ToShortDateString()</td>
                        <td>@item.Salary.ToString("C2")</td>
                        <td>
                            @if (item.Active) { <span class="badge bg-success">Ativo</span> }
                            else { <span class="badge bg-warning">Inativo</span> }
                        </td>
                        <td class="text-center">
                            <div class="btn-group">
                                <a asp-action="AlterarRegistoCriminal" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Renovar Registo">
                                    <i class="bi bi-shield-check"></i>
                                </a>
                                @if (item is adosmelhoresproject.src.Models.Trainer)
                                {
                                    <a asp-action="CalcularPagamento" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success" title="Calcular Horas">
                                        <i class="bi bi-calculator"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>