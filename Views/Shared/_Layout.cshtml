@using adosmelhoresproject.src.Services
@inject DateService DateService

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SGE</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" style="min-height: 100vh;">
        
        @* SIDEBAR *@
        <div class="sidebar-wrapper" style="width: 280px; background-color: #1a237e; min-height: 100vh;">
            @await Html.PartialAsync("_NavMenu")
        </div>

        @* ÁREA PRINCIPAL *@
        <main class="flex-grow-1" style="background-color: #f8f9fa;">
            
            @* TOP ROW (Onde está a Data do Sistema) *@
            <div class="top-row px-4 d-flex justify-content-between align-items-center bg-white border-bottom shadow-sm" style="height: 60px;">
                <div class="d-flex align-items-center">
                    <i class="bi bi-calendar3 me-2 text-primary"></i>
                    <span class="fw-bold text-secondary small text-uppercase">
                        SYSTEM DATE: [<span id="displayData">@DateService.GetCurrentDate().ToString("yyyy-MM-dd")</span>]
                    </span>
                </div>
                <div>
                    @* Botão agora é um simples botão, sem formulário *@
                    <button type="button" id="btnAvancarDia" class="btn btn-primary btn-sm px-3 shadow-sm rounded-pill">
                        <i class="bi bi-plus-circle me-1"></i> Advance 1 Day
                    </button>
                </div>
            </div>

            @* ... Resto do teu HTML (article, etc) ... *@

            @* SCRIPT NO FINAL DO BODY *@
            <script>
                            document.getElementById("btnAvancarDia").addEventListener("click", function () {
                                // Desativar botão para evitar cliques múltiplos
                                const btn = this;
                                btn.disabled = true;
                                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

                                fetch('/Simulator/AvancarDia', {
                                    method: 'POST',
                                    headers: {
                                        'X-Requested-With': 'XMLHttpRequest'
                                    }
                                })
                                .then(response => {
                                    if (!response.ok) throw new Error('Erro na rede');
                                    return response.json();
                                })
                                .then(data => {
                                    if (data.sucesso) {
                                        // Se houver alertas, mostramos uma mensagem
                                        if (data.temAlertas) {
                                            let msg = "⚠️ Alertas para " + data.novaData + ":\n";
                                            if (data.contratos.length > 0) msg += "\n- Contratos Expirados: " + data.contratos.join(", ");
                                            if (data.registos.length > 0) msg += "\n- Registos Criminais: " + data.registos.join(", ");
                                            alert(msg);
                                        }
                
                                        // Recarrega a página atual para atualizar tabelas, saldos e a data no topo
                                        location.reload();
                                    }
                                })
                                .catch(error => {
                                    console.error('Erro:', error);
                                    alert("Erro ao avançar o dia.");
                                    btn.disabled = false;
                                    btn.innerHTML = '<i class="bi bi-plus-circle me-1"></i> Advance 1 Day';
                                });
                            });
            </script>

            @* CONTEÚDO DINÂMICO *@
            <article class="content px-4 py-4">
                @RenderBody()
            </article>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>