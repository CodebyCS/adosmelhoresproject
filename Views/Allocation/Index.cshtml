@model IEnumerable<adosmelhoresproject.src.Models.Allocation>
@using adosmelhoresproject.src.Models

<div class="container-fluid py-4">
    <div class="row g-4">
        
        @* COLUNA ESQUERDA: LISTA *@
        <div class="col-lg-8">
            <div class="custom-card p-4 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 text-dark">Diretório de Alocações</h5>
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="pesquisa" class="form-control form-control-sm" placeholder="Pesquisar..." style="width: 200px;">
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr class="text-muted small">
                                <th>CURSO</th>
                                <th>FORMADOR</th>
                                <th>RECEITA</th>
                                <th>INÍCIO</th>
                                <th>FIM</th>
                                <th class="text-end">AÇÕES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Nenhuma alocação registada.</td></tr>
                            }
                            else
                            {
                                @foreach (var a in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@a.NomeFormacao</td>
                                        <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(a.EmployeeName) ? "Não Atribuído" : a.EmployeeName)</span></td>
                                        <td class="fw-bold text-success">€ @a.ValorReceita.ToString("N2")</td>
                                        <td class="small text-muted">@a.DataInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small text-muted">@a.DataFim.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: FORMULÁRIO *@
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-sm border-top border-primary border-4">
                <h5 class="fw-bold mb-4 text-primary">Nova Alocação</h5>
                <form asp-action="Criar" method="post">
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Nome do Curso</label>
                        <input type="text" name="NomeFormacao" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Formador Responsável</label>
                        <select name="EmployeeId" class="form-select" required>
                            <option value="">-- Selecione o Formador --</option>
                            @if (ViewBag.Funcionarios != null)
                            {
                                foreach (var formador in ViewBag.Funcionarios)
                                {
                                    <option value="@formador.Id">@formador.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Horas por Dia</label>
                            <input type="number" name="HorasPorDia" class="form-control" value="6" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Receita Total (€)</label>
                            <input type="number" name="ValorReceita" class="form-control" step="0.01" value="0.00" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Início</label>
                            <input type="datetime-local" name="DataInicio" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Fim</label>
                            <input type="datetime-local" name="DataFim" class="form-control" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">
                        Confirmar Alocação
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>