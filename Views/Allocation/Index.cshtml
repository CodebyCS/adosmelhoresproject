@model IEnumerable<adosmelhoresproject.src.Models.Allocation>

<div class="container-fluid py-4">
    <div class="row g-4">
        @* COLUNA ESQUERDA: LISTA *@
        <div class="col-lg-8">
            <div class="custom-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Diretório de Alocações</h5>
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="pesquisa" class="form-control form-control-sm" placeholder="Pesquisar..." style="width: 200px;">
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr>
                                <th>NOME DO CURSO</th>
                                <th>RECEITA</th>
                                <th>INÍCIO</th>
                                <th>FIM</th>
                                <th class="text-end">AÇÕES</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma alocação registada.</td></tr>
                            }
                            else
                            {
                                @foreach (var a in Model)
                                {
                                    <tr>
                                        @* CORRIGIDO: Nomes batem com a classe Alocacao *@
                                        <td class="fw-bold">@a.NomeFormacao</td>
                                        <td class="fw-bold text-success">
                                            @* Se não tiveres ValorReceita na classe, usa Salary ou outra prop decimal *@
                                            @a.HorasPorDia.ToString("N0") h/dia
                                        </td>
                                        <td class="small">@a.DataInicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="small">@a.DataFim.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary">Alterar</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* DASHBOARD *@
            <div class="row g-4 mt-1">
                <div class="col-md-6">
                    <div class="custom-card p-3 shadow-sm">
                        <h6 class="fw-bold mb-3 small text-uppercase text-muted">Utilização</h6>
                        <div class="progress mb-2" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @(ViewBag.PercentagemLivre ?? 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: FORMULÁRIO *@
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-sm border-top border-primary border-4">
                <h5 class="fw-bold mb-4 text-primary">Nova Alocação</h5>
                <form asp-action="Criar" method="post">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Nome do Curso</label>
                        @* CORRIGIDO: name="NomeFormacao" *@
                        <input type="text" name="NomeFormacao" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Horas por Dia</label>
                        @* CORRIGIDO: name="HorasPorDia" *@
                        <input type="number" name="HorasPorDia" class="form-control" value="6" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Início</label>
                            @* CORRIGIDO: name="DataInicio" *@
                            <input type="datetime-local" name="DataInicio" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Fim</label>
                            @* CORRIGIDO: name="DataFim" *@
                            <input type="datetime-local" name="DataFim" class="form-control" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                        Confirmar Alocação
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>