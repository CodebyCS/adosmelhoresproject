@using adosmelhoresproject.src.Controllers
@model IEnumerable<TransacaoDTO>

<div class="container-fluid py-4">
    <div class="row g-4">
        @* COLUNA ESQUERDA: TRANSAÇÕES E GRÁFICO *@
        <div class="col-lg-8">
            <div class="custom-card p-4 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Registro de Transações</h5>
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="pesquisa" class="form-control form-control-sm" placeholder="Pesquisar..." style="width: 200px;">
                        <select name="filtroTipo" class="form-select form-select-sm" style="width: 150px;" onchange="this.form.submit()">
                            <option value="Todos">Todos os Tipos</option>
                            <option value="Receita">Receitas</option>
                            <option value="Despesa">Despesas</option>
                        </select>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr>
                                <th style="width: 80px;">ID</th>
                                <th>TIPO</th>
                                <th>REF/FUNCIONÁRIO</th>
                                <th>DATA</th>
                                <th>VALOR</th>
                                <th>ESTADO</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model == null || !Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Sem transações registadas.</td></tr>
                            }
                            else
                            {
                                @foreach (var t in Model)
                                {
                                    <tr>
                                        <td class="text-muted small">@t.Id</td>
                                        <td class="fw-bold">@t.Descricao</td>
                                        <td>@t.Referencia</td>
                                        <td class="small">@t.Data.ToShortDateString()</td>
                                        <td class="@(t.Valor < 0 ? "text-danger" : "text-success") fw-bold">
                                            @(t.Valor < 0 ? "-" : "+")€@Math.Abs(t.Valor).ToString("N2")
                                        </td>
                                        <td>
                                            <span class="status-badge @(t.Estado == "Pago" || t.Estado == "Recebido" ? "bg-success-subtle text-success" : "bg-info-subtle text-info") px-2 py-1 rounded small">
                                                @t.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @* GRÁFICO DE FLUXO DE CAIXA (Simulado com CSS) *@
            <div class="custom-card p-4 mt-4 shadow-sm">
                <h6 class="fw-bold mb-4 small text-uppercase text-muted">Fluxo de Caixa (Receitas vs Despesas)</h6>
                <div class="d-flex align-items-end justify-content-between px-2" style="height: 200px; border-bottom: 2px solid #e2e8f0;">
                    @foreach (var mes in ViewBag.FluxoMensal)
                    {
                        <div class="d-flex gap-1 align-items-end h-100" style="width: 12%;">
                            <div class="bg-primary shadow-sm"
                                 style="height: @(mes.ReceitaPerc)%; width: 10px; border-radius: 3px 3px 0 0;"
                                 title="Receita: €@mes.Receita"></div>
                            <div class="bg-secondary opacity-50"
                                 style="height: @(mes.DespesaPerc)%; width: 10px; border-radius: 3px 3px 0 0;"
                                 title="Despesa: €@mes.Despesa"></div>
                        </div>
                    }
                </div>
                <div class="d-flex justify-content-between mt-2 px-2 text-muted small fw-bold">
                    @foreach (var mes in ViewBag.FluxoMensal)
                    {
                        <span style="width: 12%; text-align: center;">@mes.Nome</span>
                    }
                </div>
            </div>
        </div>

        @* COLUNA DIREITA: VISÃO GERAL E EXPORTAÇÃO *@
        <div class="col-lg-4">
            <div class="custom-card p-4 shadow-sm">
                <h5 class="fw-bold mb-4">Visão Geral Financeira</h5>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Saldo Atual</span>
                    <h3 class="fw-bold text-dark mb-0">€@ViewBag.SaldoAtual.ToString("N2")</h3>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Receitas Este Mês</span>
                    <h4 class="fw-bold text-success mb-0">€@ViewBag.ReceitasMes.ToString("N2")</h4>
                </div>
                <div class="d-flex justify-content-between mb-3 pb-3 border-bottom">
                    <span class="text-muted small">Despesas Este Mês</span>
                    <h4 class="fw-bold text-danger mb-0">€@ViewBag.DespesasMes.ToString("N2")</h4>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Rentabilidade</span>
                    <h4 class="fw-bold text-primary mb-0">@ViewBag.Rentabilidade.ToString("F1")%</h4>
                </div>
            </div>

            <div class="custom-card p-4 mt-4 shadow-sm">
                <h6 class="fw-bold mb-3 small text-uppercase text-muted">Ferramentas e Alertas</h6>
                <a asp-action="ExportarPDF" class="btn btn-outline-primary w-100 py-2 mb-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-file-earmark-pdf me-2 fs-5"></i> Exportar Auditoria (PDF)
                </a>
                <a asp-action="ExportarExcel" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center">
                    <i class="bi bi-file-earmark-excel me-2 fs-5"></i> Exportar Contabilidade (Excel)
                </a>
            </div>
        </div>
    </div>
</div>